# Bot token from @BotFather
TELEGRAM_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (everyone else is ignored)
ALLOWED_USER_IDS=
# Optional: pay per use with an API key instead of the Claude subscription login
# ANTHROPIC_API_KEY=
# Claude Code permission mode: default | acceptEdits | plan | dontAsk | bypassPermissions | auto
PERMISSION_MODE=auto
# Optional: path to a claude CLI to use instead of the one bundled with the SDK
CLAUDE_CLI_PATH=
# Optional: where sessions.json and the lock file live (default: ./state)
STATE_DIR=
# Run each conversation's Claude in its own Docker container, capped in CPU and memory
SANDBOX_DOCKER=true
DOCKER_CPUS=2
DOCKER_MEMORY=4g
# Per-folder overrides, folder=cpus[:memory],… (changes apply to running containers on
# their next message, without stopping what runs in them)
DOCKER_LIMITS=
# Folders (first level of the workdir) whose conversations run on the host instead,
# e.g. one to watch over the containers from outside
DOCKER_EXCLUDE=
# Without Docker: sandbox Bash so it can only write inside the workdir (needs working
# unprivileged bubblewrap; on Ubuntu 24.04+ AppArmor blocks it by default)
SANDBOX_BASH=false
