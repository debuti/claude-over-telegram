# Bot token from @BotFather
TELEGRAM_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (everyone else is ignored)
ALLOWED_USER_IDS=
# Optional: pay per use with an API key instead of the Claude subscription login
# ANTHROPIC_API_KEY=
# Claude Code permission mode: default | acceptEdits | plan | dontAsk | bypassPermissions | auto
PERMISSION_MODE=default
# Optional: path to a claude CLI to use instead of the one bundled with the SDK
CLAUDE_CLI_PATH=
# Optional: where sessions.json and the lock file live (default: ./state)
STATE_DIR=
# Optional: sandbox Bash so it can only write inside the workdir (needs working
# unprivileged bubblewrap; on Ubuntu 24.04+ AppArmor blocks it by default)
SANDBOX_BASH=false
